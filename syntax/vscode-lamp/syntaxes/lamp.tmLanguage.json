{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lamp",
  "scopeName": "source.lamp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#python-block"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#std"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#signals"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lamp",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.lamp"
            }
          },
          "end": "$\n?"
        },
        {
          "name": "comment.block.lamp",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.lamp"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.lamp"
            }
          }
        }
      ]
    },
    "python-block": {
      "patterns": [
        {
          "name": "meta.embedded.block.python.lamp",
          "begin": "^\\s*(#\\[python\\])\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.python.lamp"
            }
          },
          "end": "^\\s*(#\\[endpython\\])\\s*$",
          "endCaptures": {
            "1": {
              "name": "keyword.control.directive.python.lamp"
            }
          },
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lamp",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lamp"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lamp"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lamp",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.lamp",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.lamp"
            }
          },
          "end": "'",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lamp"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.lamp",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lamp",
          "match": "\\b(fn|struct|trait|impl|mod|import|from|use|pub|as|if|elif|else|loop|for|while|in|return|continue|break)\\b"
        },
        {
          "name": "constant.language.boolean.lamp",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "entity.name.function.macro.lamp",
          "match": "(?<=#)\\w+(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.lamp",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "storage.type.annotation.lamp",
          "match": "(?<=:)\\s*\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.lamp",
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.lamp"
            }
          }
        },
        {
          "name": "support.function.call.lamp",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "support.function.call.lamp"
            }
          }
        },
        {
          "name": "variable.other.property.lamp",
          "match": "\\.([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.other.property.lamp"
            }
          }
        }
      ]
    },
    "std": {
      "patterns": [
        {
          "name": "support.module.std.lamp",
          "match": "\\bstd\\b"
        },
        {
          "name": "support.module.std.path.lamp",
          "match": "\\bstd(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        }
      ]
    },
    "signals": {
      "patterns": [
        {
          "name": "variable.other.special.signal.lamp",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "keyword.operator.reactive.lamp",
          "match": "\\$(?=\\s*\\{)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lamp",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lamp",
          "match": "\\|>|<\\||=>|->|\\+\\=|\\-\\=|\\*\\*=|\\*\\=|/\\=|%\\=|==|!=|<=|>=|\\|\\||&&|:=|\\.\\.|[+\\-*/%<>=!&|^~@]"
        }
      ]
    }
  }
}
